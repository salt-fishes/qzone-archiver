{
  "name": "qzone-archiver-desktop",
  "version": "5.3.1",
  "private": true,
  "description": "QQ空间档案备份桌面版（内嵌登录 → 采集 → 打包 → 内置 SPA 浏览）",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "gen:config": "node scripts/gen-engine-config.mjs && node scripts/gen-ui-schema.mjs",
    "gen:emoticons": "node scripts/gen-emoticons-manifest.mjs && node scripts/sync-emoticons.mjs",
    "gen:icon": "node scripts/gen-app-icon.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "vite",
    "build:renderer": "node scripts/sync-emoticons.mjs && vite build",
    "build:viewer": "npm --prefix archive-viewer install --no-audit --no-fund && npm --prefix archive-viewer run build",
    "install:viewer": "npm --prefix archive-viewer install",
    "start": "electron .",
    "start:dev": "npm run build:renderer && electron .",
    "dist": "npm run gen:icon && npm run build:renderer && npm run build:viewer && electron-builder --publish never",
    "dist:win": "npm run gen:icon && npm run build:renderer && npm run build:viewer && electron-builder --win --publish never"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "motion-v": "^2.4.2",
    "naive-ui": "^2.45.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.2.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.7"
  }
}
