# ============ 用户隐私数据（绝不入库）============
# QQ 空间备份导出目录（含真实用户数据）
QQ空间备份_*/
# 备份产物中的 JSON 数据
Common/json/

# ============ 辅助/参考项目（独立仓库）============
GetQzonehistory-main/
原版/
taste-skill-main/

# ============ 本地文档（不随项目提交）============
docs/
# 更新计划与版本更新记录（个人工作区，含未定稿计划）
plans/

# ============ 构建产物 ============
# SPA 构建输出
src/export/spa-dist/
src/spa/dist/
# 扩展打包发布
releases/
*.zip
*.crx
*.pem
# 桌面版构建产物
desktop/dist/
desktop/release/
desktop/src/renderer/dist/
# 打包图标产物（由 scripts/gen-app-icon.mjs 从 src/main/icon-source.png 方形母图生成，打包前自动重建）
desktop/build/
# 表情同步产物（由 scripts/sync-emoticons.mjs 从 desktop/assets/emoticons 生成，构建前自动重建）
desktop/src/renderer/public/emoticons/

# ============ 依赖 ============
node_modules/
package-lock.json
yarn.lock
# 桌面端锁文件入库：CI 的 npm ci 与 setup-node 缓存依赖它（b694cdc 发布后首次跑 CI 发现）
!desktop/package-lock.json

# ============ SPA 测试数据（含真实隐私，本地保留）============
# 开发时放入测试数据，不入库；保留目录结构通过 .gitkeep
src/spa/public/Common/json/
src/spa/public/Messages/data/*.js
src/spa/public/Visitors/data/*.js
src/spa/public/Videos/data/*.js
src/spa/public/Albums/data/*.js
src/spa/public/Blogs/data/*.js
src/spa/public/Diaries/data/*.js
src/spa/public/Favorites/data/*.js
src/spa/public/Friends/data/*.js
src/spa/public/Shares/data/*.js
src/spa/public/Boards/data/*.js

